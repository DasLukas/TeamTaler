# Public HTTPS URL exposed by the existing reverse proxy.
TEAMTALER_PUBLIC_URL=https://teamtaler.example.com

# Only forwarded headers from the exact reverse-proxy address or subnet are trusted.
# Leave empty until the proxy source address has been identified; never trust a whole shared container range.
TEAMTALER_TRUSTED_PROXY_CIDRS=

# Container runtime paths. Keep these values when using compose.yaml.
TEAMTALER_LISTEN=0.0.0.0:8080
TEAMTALER_DATA_DIR=/var/lib/teamtaler
TEAMTALER_DATABASE_PATH=/var/lib/teamtaler/teamtaler.db
TEAMTALER_WEB_DIR=/app/web
# Request-body ceiling for ordinary API operations. Media and receipt upload
# routes use their live setting plus multipart overhead instead.
TEAMTALER_MAX_REQUEST_BYTES=6291456

# Runtime-editable instance defaults. A SYSTEM_ADMINISTRATOR may persist an
# override through the web interface or operator CLI; removing that override
# activates the current environment value again without restarting TeamTaler.
TEAMTALER_INSTANCE_NAME=TeamTaler
TEAMTALER_DEFAULT_CURRENCY=EUR
# Whole MiB only: 1048576 (1 MiB) through 26214400 (25 MiB).
TEAMTALER_MEDIA_UPLOAD_MAX_BYTES=5242880
# Whole MiB only: 1048576 (1 MiB) through 52428800 (50 MiB).
TEAMTALER_ATTACHMENT_UPLOAD_MAX_BYTES=15728640
TEAMTALER_PUBLIC_JOIN_ENABLED=true
TEAMTALER_MAINTENANCE_MODE=false
TEAMTALER_MAINTENANCE_MESSAGE=

# SMTP delivery is disabled while every variable below remains unset. These
# values are environment defaults and may be replaced by a tested, encrypted
# runtime override. TLS is mandatory: use starttls (default, commonly port 587)
# or tls (implicit TLS, commonly port 465).
#TEAMTALER_SMTP_HOST=smtp.example.com
#TEAMTALER_SMTP_PORT=587
#TEAMTALER_SMTP_USERNAME=teamtaler@example.com
#TEAMTALER_SMTP_PASSWORD=replace-with-a-secret
#TEAMTALER_SMTP_FROM_ADDRESS=teamtaler@example.com
#TEAMTALER_SMTP_FROM_NAME=TeamTaler
#TEAMTALER_SMTP_TLS_MODE=starttls
# Runtime SMTP overrides may connect only to public addresses by default. Set
# this host-only trust switch only when a web-configured relay must be reached
# through a private, loopback, link-local, or otherwise non-public address.
TEAMTALER_SMTP_ALLOW_PRIVATE_NETWORK=false
# Required with SMTP and persisted SMTP credentials: standard base64 encoding
# of a random 32-byte AES key. Purpose-specific derived keys protect queued
# email tokens and the runtime SMTP password at rest.
# Generate a new key with: openssl rand -base64 32
#TEAMTALER_EMAIL_TOKEN_KEY=replace-with-a-base64-encoded-32-byte-key

# Standards-based Web Push is disabled until the complete block below is
# configured. The subject must be a mailto: address or an absolute HTTPS URL.
# Generate a VAPID key through `teamtaler admin system web-push generate` and
# keep the private key secret. Browser subscription envelopes use their own
# independent base64-encoded 32-byte storage key.
TEAMTALER_WEB_PUSH_ENABLED=false
#TEAMTALER_WEB_PUSH_SUBJECT=mailto:admin@example.com
#TEAMTALER_WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-a-vapid-private-key
# Generate with: openssl rand -base64 32
#TEAMTALER_PUSH_STORAGE_KEY=replace-with-a-base64-encoded-32-byte-key

# Host and image settings used by Docker Compose.
TEAMTALER_HOST_PORT=8080
TEAMTALER_IMAGE=ghcr.io/daslukas/teamtaler
TEAMTALER_VERSION=1.0.0
